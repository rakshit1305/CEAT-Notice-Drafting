# ─── Which model provider ────────────────────────────────────────────────────
# LLM_PROVIDER picks one, per machine — same code, only this file differs:
#   groq     Groq's hosted models (the default when the line is absent)
#   openai   any OpenAI-compatible endpoint
#   azure    an Azure OpenAI resource, set up the same way as ceat-compintel
# Fill in the block for the one you choose; the others are ignored.

# ─── Groq — https://console.groq.com/keys ────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here
# Leave these commented to let the app pick the best model your key can reach.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ─── OpenAI-compatible endpoint ──────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# Set these to the strongest model your OpenAI account can actually reach —
# check platform.openai.com/docs/models before picking. Do NOT leave this on
# a "mini" tier; that reintroduces the same weak-model problem Groq had.
OPENAI_TEXT_MODEL=gpt-5.1
OPENAI_VISION_MODEL=gpt-5.1

# ─── Azure OpenAI (LLM_PROVIDER=azure) ───────────────────────────────────────
# The same variable names as ceat-compintel, so its Azure block can be pasted
# here unchanged.
# Azure addresses DEPLOYMENT names you created in the portal, NOT model ids.
# "gpt-4.1" is not a valid target unless you named a deployment that; a wrong
# name surfaces as a 404 DeploymentNotFound.
# The endpoint may be either form — the app tells them apart from the URL:
#   https://<resource>.openai.azure.com/            (uses AZURE_OPENAI_API_VERSION)
#   https://<resource>.openai.azure.com/openai/v1   (no API version needed)
#AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_API_VERSION=2024-10-21
# Which deployment reads and writes text. Either name it directly …
#AZURE_TEXT_DEPLOYMENT=
# … or leave that out and the ceat-compintel names are used: tier 2 (the
# stronger one) if set, otherwise tier 1.
#AZURE_TIER2_DEPLOYMENT=
#AZURE_TIER1_DEPLOYMENT=
# Which deployment reads cheque photos and scans. Defaults to the text one.
#AZURE_VISION_DEPLOYMENT=
# Azure returns tokens but never a price. Without this, cost_usd in llm_calls
# stays empty. JSON: {"<deployment>": [usd_per_1k_input, usd_per_1k_output]}
#LLM_PRICE_TABLE={"ceat-gpt41":[0.002,0.008]}

# ─── Rate limits and timeouts (any provider) ─────────────────────────────────
# How many times a rate-limited or timed-out call is waited out and retried,
# and for how long. Defaults: 5 retries and a 120 s timeout on Azure, where a
# 429 is ordinary traffic; 0 extra retries and 40 s on Groq / OpenAI.
#LLM_MAX_RETRIES=5
#LLM_RETRY_BASE_SECONDS=2
#LLM_RETRY_MAX_SECONDS=90
#LLM_TIMEOUT_SECONDS=120

# ─── Limits ──────────────────────────────────────────────────────────────────
# Largest attachment accepted, in megabytes.
MAX_UPLOAD_MB=25
# How much of an attachment is sent to the model: rows per sheet, and
# characters of text. The app flags anything that was cut off.
#MAX_SHEET_ROWS=400
#MAX_DOC_CHARS=24000

# ─── Database (optional) ─────────────────────────────────────────────────────
# Configure it and the app keeps matters, attachments, drafted notices and the
# office list in Postgres, and everyone signs in with their own account.
# Leave it all commented and the app runs as before, in the browser session only.
# The app creates its tables on first start, and the ceat_notices database too
# where its role is allowed to (otherwise: db/bootstrap.sql, once).
#
# Pick ONE of the two ways. If both are filled in, DATABASE_URL wins.
#
# 1) One address. The ceat-compintel spelling (postgresql+psycopg://…) and its
#    other name for it (DATABASE_URL_LOCAL) are accepted too.
# DATABASE_URL=postgresql://ceat:your_db_password@localhost:5432/ceat_notices
#
# 2) The pieces, named as in ceat-compintel — copy its Postgres block and change
#    only POSTGRES_DB. The role and the server can be the ones that project
#    uses; the database must be this app's own (the app refuses ceat_compintel).
# POSTGRES_USER=ceat
# POSTGRES_PASSWORD=your_db_password
# POSTGRES_DB=ceat_notices
#    Where the server is. ceat-compintel's dev stack: localhost and 5433.
#    The shared database server: its private address and 5432 (7000 on the
#    hardened one). POSTGRES_HOST / POSTGRES_PORT are read as well.
# DB_HOST=localhost
# DB_PORT=5433
#    Only for a server that requires TLS / is reached over the internet:
# DB_SSL_PARAMS="sslmode=verify-full&sslrootcert=/etc/ssl/ceat/ca.crt"
# DB_WAN_PARAMS="connect_timeout=10&keepalives=1&keepalives_idle=30&keepalives_interval=10&keepalives_count=5"

# The first admin, created once when there are no accounts yet. You are made to
# change this password at first sign-in. Change these BEFORE the first start on
# anything reachable from the internet.
# ADMIN_EMAIL=admin@ceat.com
# ADMIN_PASSWORD=ChangeMe@123
# The ceat-compintel names work as well, if you would rather keep one .env
# layout for both projects (this app's own name wins when both are set):
# SEED_ADMIN_EMAIL=admin@ceat.com
# SEED_ADMIN_PASSWORD=ChangeMe@123

# Hours before a sign-in expires. (SESSION_TTL_HOURS is accepted too.)
# SESSION_HOURS=12

# ─── Without a database ──────────────────────────────────────────────────────
# One shared password for the whole app.
# APP_PASSWORD=
# Where the list of issuing offices is kept (offices.json beside app.py by
# default). With a database it lives in the offices table instead.
# OFFICES_JSON=/path/that/survives/a/redeploy/offices.json
