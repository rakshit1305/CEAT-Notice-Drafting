# Groq — https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# Leave these commented to let the app pick the best model your key can reach.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Using an OpenAI-compatible endpoint since no Anthropic/Claude API key is available.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# Set these to the strongest model your OpenAI account can actually reach —
# check platform.openai.com/docs/models before picking. Do NOT leave this on
# a "mini" tier; that reintroduces the same weak-model problem Groq had.
OPENAI_TEXT_MODEL=gpt-5.1
OPENAI_VISION_MODEL=gpt-5.1

MAX_UPLOAD_MB=25
