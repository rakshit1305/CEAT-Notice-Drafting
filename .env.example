# Groq — https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# Leave these commented to let the app pick the best model your key can reach.
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Using an OpenAI-compatible endpoint since no Anthropic/Claude API key is available.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# Set these to the strongest model your OpenAI account can actually reach —
# check platform.openai.com/docs/models before picking. Do NOT leave this on
# a "mini" tier; that reintroduces the same weak-model problem Groq had.
OPENAI_TEXT_MODEL=gpt-5.1
OPENAI_VISION_MODEL=gpt-5.1

MAX_UPLOAD_MB=25

# --- Database (optional) ------------------------------------------------------
# Set this and the app keeps matters, attachments, drafted notices and the
# office list in Postgres, and everyone signs in with their own account.
# Leave it commented and the app runs as before, in the browser session only.
# The app creates the ceat_notices database and its tables on first start.
# DATABASE_URL=postgresql://ceat:your_db_password@localhost:5432/ceat_notices

# The first admin, created once when there are no accounts yet. You are made to
# change this password at first sign-in. Change these BEFORE the first start on
# anything reachable from the internet.
# ADMIN_EMAIL=admin@ceat.com
# ADMIN_PASSWORD=ChangeMe@123

# Hours before a sign-in expires.
# SESSION_HOURS=12

# Without a database: one shared password for the whole app.
# APP_PASSWORD=
